      "name": "Dërgo veprimin te automatizimi",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH matched_operation AS (\n  SELECT status, completed_at\n  FROM public.dispatch_operations\n  WHERE operation_key = $1::TEXT\n    AND assignment_id = $2::TEXT\n    AND trip_id = $3::TEXT\n    AND driver_id = $4::TEXT\n    AND action = $5::TEXT\n)\nSELECT\n  EXISTS (\n    SELECT 1\n    FROM matched_operation\n    WHERE status = 'completed'\n  ) AS operation_completed,\n  COALESCE(\n    (SELECT status FROM matched_operation),\n    'missing'\n  ) AS operation_status,\n  (SELECT completed_at FROM matched_operation)\n    AS completed_at;",
        "options": {
          "queryReplacement": "={{ [\n  $('Krijo tokenin e veprimit të agjentit').first().json.operation_key,\n  $('Krijo tokenin e veprimit të agjentit').first().json.assignment_id,\n  $('Krijo tokenin e veprimit të agjentit').first().json.trip_id,\n  $('Krijo tokenin e veprimit të agjentit').first().json.driver_id,\n  $('Krijo tokenin e veprimit të agjentit').first().json.action\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        2304,
        -96
      ],
      "id": "67a9c60d-1852-4082-9ffc-73db4f337682",
      "name": "Kontrollo përfundimin e veprimit",
      "credentials": {
        "postgres": {
          "id": "Id7hgCXJzaN1cbFO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const request =\n  $('Kontrollo pronësinë dhe gjendjen').first().json;\n\nconst response =\n  $('Dërgo veprimin te automatizimi').first().json;\n\nconst completed = $json.operation_completed === true;\nconst status = $json.operation_status;\n\nconst responseConfirmed =\n  Number(response.statusCode) >= 200 &&\n  Number(response.statusCode) < 300;\n\nconst messages = {\n  PRANO: 'Udhëtimi u pranua.',\n  REFUZO: 'Refuzimi i udhëtimit u regjistrua.',\n  FILLIM: 'Fillimi u regjistrua. Udhëtimi është në vazhdim.',\n  PERFUNDIM:\n    'Udhëtimi u përfundua dhe shoferi është i lirë.'\n};\n\nlet httpStatus;\nlet code;\nlet message;\n\nif (completed) {\n  httpStatus = 200;\n  code = 'ACTION_COMPLETED';\n  message = messages[request.action];\n\n  if (\n    !responseConfirmed &&\n    ['PRANO', 'REFUZO', 'FILLIM'].includes(request.action)\n  ) {\n    message +=\n      ' Njoftimet nuk u konfirmuan plotësisht; kontrollo email-in.';\n  }\n} else if (status === 'processing') {\n  httpStatus = 202;\n  code = 'ACTION_PROCESSING';\n  message =\n    'Veprimi është ende në përpunim. Kontrollo përsëri gjendjen e udhëtimit para se ta përsërisësh.';\n} else {\n  httpStatus = 503;\n  code = 'ACTION_NOT_CONFIRMED';\n  message =\n    'Veprimi nuk u konfirmua plotësisht. Kontrollo gjendjen e udhëtimit para se ta përsërisësh.';\n}\n\nreturn {\n  json: {\n    ok: completed,\n    httpStatus,\n    code,\n    tripId: request.tripId,\n    action: request.action,\n    message\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
