    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const request =\n  $('Kontrollo pronësinë dhe gjendjen').first().json;\n\nconst record = $json;\nconst fields = record.fields ?? record;\n\nconst success =\n  record.id === request.tripId &&\n  typeof fields['Çmimi'] === 'number' &&\n  fields['Çmimi'] === request.price;\n\nreturn {\n  json: {\n    ok: success,\n    httpStatus: success ? 200 : 503,\n    code: success\n      ? 'PRICE_UPDATED'\n      : 'PRICE_NOT_CONFIRMED',\n    tripId: request.tripId,\n    price: success ? fields['Çmimi'] : null,\n    message: success\n      ? `Çmimi i udhëtimit u vendos në ${fields['Çmimi']}.`\n      : 'Përditësimi i çmimit nuk u konfirmua. Kontrollo udhëtimin.'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
