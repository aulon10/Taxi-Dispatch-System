    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  ok: $json.ok,\n  code: $json.code,\n  tripId: $json.tripId,\n  price: $json.price,\n  message: $json.message\n} }}",
        "options": {
