      "id": "26043b72-ffb0-424d-b57f-cd37a282f164",
      "name": "Kthe rezultatin e çmimit"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH eligible AS (\n  SELECT\n    r.assignment_id,\n    r.trip_id,\n    r.driver_id,\n    $3::TEXT AS action,\n    r.assignment_id ||\n      CASE $3::TEXT\n        WHEN 'PRANO' THEN ':decision'\n        WHEN 'REFUZO' THEN ':decision'\n        WHEN 'FILLIM' THEN ':start'\n        WHEN 'PERFUNDIM' THEN ':finish'\n      END AS operation_key\n  FROM public.driver_reservations r\n  JOIN public.taxi_auth_sessions s\n    ON s.actor_id = r.driver_id\n   AND s.token_hash = $4::TEXT\n   AND s.role = 'DRIVER'\n   AND s.revoked_at IS NULL\n   AND s.expires_at > clock_timestamp()\n  WHERE r.driver_id = $1::TEXT\n    AND r.trip_id = $2::TEXT\n    AND $3::TEXT IN (\n      'PRANO', 'REFUZO', 'FILLIM', 'PERFUNDIM'\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM public.dispatch_operations o\n      WHERE o.trip_id = r.trip_id\n        AND o.status = 'processing'\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM public.dispatch_operations o\n      WHERE o.operation_key =\n        r.assignment_id ||\n        CASE $3::TEXT\n          WHEN 'PRANO' THEN ':decision'\n          WHEN 'REFUZO' THEN ':decision'\n          WHEN 'FILLIM' THEN ':start'\n          WHEN 'PERFUNDIM' THEN ':finish'\n        END\n    )\n    AND (\n      $3::TEXT IN ('PRANO', 'REFUZO')\n      OR EXISTS (\n        SELECT 1\n        FROM public.dispatch_operations o\n        WHERE o.assignment_id = r.assignment_id\n          AND o.trip_id = r.trip_id\n          AND o.driver_id = r.driver_id\n          AND o.status = 'completed'\n          AND o.operation_key =\n            r.assignment_id ||\n            CASE $3::TEXT\n              WHEN 'FILLIM' THEN ':decision'\n              WHEN 'PERFUNDIM' THEN ':start'\n            END\n          AND o.action =\n            CASE $3::TEXT\n              WHEN 'FILLIM' THEN 'PRANO'\n              WHEN 'PERFUNDIM' THEN 'FILLIM'\n            END\n      )\n    )\n),\ngenerated AS MATERIALIZED (\n  SELECT\n    e.*,\n    encode(gen_random_bytes(32), 'hex') AS raw_token\n  FROM eligible e\n),\ncreated AS (\n  INSERT INTO public.action_tokens (\n    token_hash,\n    assignment_id,\n    trip_id,\n    driver_id,\n    action,\n    expires_at\n  )\n  SELECT\n    encode(digest(g.raw_token, 'sha256'), 'hex'),\n    g.assignment_id,\n    g.trip_id,\n    g.driver_id,\n    g.action,\n    clock_timestamp() + INTERVAL '5 minutes'\n  FROM generated g\n  ON CONFLICT DO NOTHING\n  RETURNING token_hash\n)\nSELECT\n  EXISTS (SELECT 1 FROM created) AS token_created,\n  $3::TEXT AS action,\n  g.raw_token AS action_token,\n  g.assignment_id,\n  g.trip_id,\n  g.driver_id,\n  g.operation_key\nFROM (VALUES (1)) AS result(n)\nLEFT JOIN generated g\n  ON EXISTS (\n    SELECT 1\n    FROM created c\n    WHERE c.token_hash =\n      encode(digest(g.raw_token, 'sha256'), 'hex')\n  );",
        "options": {
          "queryReplacement": "={{ [\n  $json.driverId,\n  $json.tripId,\n  $json.action,\n  $json.sessionHash\n] }}"
        }
      },
