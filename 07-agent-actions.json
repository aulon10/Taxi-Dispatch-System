    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst body = $json.body ?? {};\n\nconst token = body.sessionToken;\n\nconst validToken =\n  typeof token === 'string' &&\n  /^[a-f0-9]{64}$/.test(token);\n\nconst action = typeof body.action === 'string'\n  ? body.action.trim().toUpperCase()\n  : '';\n\nconst tripId = typeof body.tripId === 'string'\n  ? body.tripId.trim()\n  : '';\n\nconst allowedActions = [\n  'PRANO',\n  'REFUZO',\n  'FILLIM',\n  'PERFUNDIM',\n  'PERDITESO_CMIMIN'\n];\n\nconst validAction = allowedActions.includes(action);\nconst validTrip = /^rec[a-zA-Z0-9]{14}$/.test(tripId);\n\nconst validPrice =\n  action !== 'PERDITESO_CMIMIN' ||\n  (\n    typeof body.price === 'number' &&\n    Number.isFinite(body.price) &&\n    body.price >= 0\n  );\n\nconst validRequest =\n  validToken &&\n  validAction &&\n  validTrip &&\n  validPrice &&\n  body.confirmed === true;\n\nreturn {\n  json: {\n    validRequest,\n    sessionHash: validToken\n      ? crypto.createHash('sha256').update(token).digest('hex')\n      : null,\n    action,\n    tripId,\n    price: action === 'PERDITESO_CMIMIN' && validPrice\n      ? body.price\n      : null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        0
      ],
      "id": "2654e838-ba26-41ac-a76c-6d3c20009703",
      "name": "Kontrollo kërkesën e veprimit"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH current_session AS (\n  SELECT s.actor_id, s.role, s.email\n  FROM public.taxi_auth_sessions s\n  WHERE s.token_hash = $1::TEXT\n    AND $2::BOOLEAN\n    AND s.revoked_at IS NULL\n    AND s.expires_at > clock_timestamp()\n)\nSELECT\n  EXISTS (\n    SELECT 1 FROM current_session\n  ) AS valid_session,\n  (\n    SELECT row_to_json(s)\n    FROM current_session s\n  ) AS session;",
        "options": {
          "queryReplacement": "={{ [$json.sessionHash, $json.validRequest] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        368,
        0
      ],
      "id": "3601bfcf-5e2b-4468-af5b-31808f26735c",
      "name": "Verifiko sesionin për veprimin",
      "credentials": {
        "postgres": {
          "id": "Id7hgCXJzaN1cbFO",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const request =\n  $('Kontrollo kërkesën e veprimit').first().json;\n\nconst session = $json.session;\n\nlet authorized = false;\nlet httpStatus = 200;\nlet code = 'AUTHORIZED';\nlet message = '';\n\nif (!request.validRequest) {\n  httpStatus = 400;\n  code = 'INVALID_REQUEST';\n  message = 'Kërkesa e veprimit nuk është e vlefshme.';\n} else if (!$json.valid_session || !session) {\n  httpStatus = 401;\n  code = 'SESSION_INVALID';\n  message = 'Hyrja nuk është më e vlefshme. Hyr përsëri.';\n} else if (session.role !== 'DRIVER') {\n  httpStatus = 403;\n  code = 'FORBIDDEN';\n  message = 'Vetëm shoferi mund ta kryejë këtë veprim.';\n} else {\n  authorized = true;\n}\n\nreturn {\n  json: {\n    ...request,\n    authorized,\n    driverId: authorized ? session.actor_id : null,\n    verifiedEmail: authorized ? session.email : null,\n    httpStatus,\n    code,\n    message\n  }\n};"
      },
