    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context =\n  $('Autorizo veprimin e shoferit').first().json;\n\nconst driverRecord =\n  $('Lexo shoferin e veprimit').first().json;\n\nconst tripRecord = $json;\n\nconst driver = driverRecord.fields ?? driverRecord;\nconst trip = tripRecord.fields ?? tripRecord;\n\nconst text = value => String(value ?? '').trim();\n\nconst driverStatus = text(driver.Statusi);\nconst tripStatus = text(trip.Statusi);\n\nconst profileMatches =\n  driverRecord.id === context.driverId &&\n  text(driver.Email).toLowerCase() ===\n    text(context.verifiedEmail).toLowerCase();\n\nconst ownsTrip =\n  tripRecord.id === context.tripId &&\n  Array.isArray(trip.Shoferi) &&\n  trip.Shoferi.length === 1 &&\n  trip.Shoferi[0] === context.driverId;\n\nlet stateAllowsAction = false;\n\nswitch (context.action) {\n  case 'PRANO':\n  case 'REFUZO':\n    stateAllowsAction =\n      tripStatus === 'CAKTUAR' &&\n      driverStatus === 'I ZËNË';\n    break;\n\n  case 'FILLIM':\n    stateAllowsAction =\n      tripStatus === 'PRANUAR' &&\n      driverStatus === 'I ZËNË';\n    break;\n\n  case 'PERFUNDIM':\n    stateAllowsAction =\n      tripStatus === 'NË UDHËTIM' &&\n      driverStatus === 'NË UDHËTIM' &&\n      Boolean(trip['Data e fillimit']);\n    break;\n\n    case 'PERDITESO_CMIMIN':\n    stateAllowsAction = [\n      'PRANUAR',\n      'NË UDHËTIM',\n      'PËRFUNDUAR'\n    ].includes(tripStatus);\n    break;\n}\n\nlet httpStatus = 200;\nlet code = 'ELIGIBLE';\nlet message = '';\n\nif (!profileMatches) {\n  httpStatus = 401;\n  code = 'SESSION_INVALID';\n  message = 'Profili nuk u verifikua. Hyr përsëri.';\n} else if (!ownsTrip) {\n  httpStatus = 403;\n  code = 'TRIP_FORBIDDEN';\n  message = 'Mund të veprosh vetëm mbi udhëtimet e tua.';\n} else if (!stateAllowsAction) {\n  httpStatus = 409;\n  code = 'INVALID_STATE';\n  message = 'Gjendja e udhëtimit nuk e lejon këtë veprim.';\n}\n\nreturn {\n  json: {\n    ...context,\n    allowedTrip:\n      profileMatches && ownsTrip && stateAllowsAction,\n    httpStatus,\n    code,\n    message\n  }\n};"
      },
