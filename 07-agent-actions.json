    {
      "parameters": {
        "method": "POST",
        "url": "={{ ({\n  PRANO: 'https://aulon10.app.n8n.cloud/webhook/taxi-driver-response',\n  REFUZO: 'https://aulon10.app.n8n.cloud/webhook/taxi-driver-response',\n  FILLIM: 'https://aulon10.app.n8n.cloud/webhook/taxi-trip-start-response',\n  PERFUNDIM: 'https://aulon10.app.n8n.cloud/webhook/taxi-trip-finish-response'\n})[$json.action] }}",
