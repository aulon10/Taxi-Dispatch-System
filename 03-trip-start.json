    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH eligible_reservation AS (\n  SELECT r.*\n  FROM driver_reservations r\n  JOIN dispatch_operations o\n    ON o.assignment_id = r.assignment_id\n   AND o.trip_id = r.trip_id\n   AND o.driver_id = r.driver_id\n  WHERE o.operation_key = $1\n    AND o.execution_id = $2\n    AND o.action = 'FILLIM'\n    AND o.status = 'completed'\n),\ngenerated_token AS MATERIALIZED (\n  SELECT\n    assignment_id,\n    trip_id,\n    driver_id,\n    encode(gen_random_bytes(32), 'hex') AS token,\n    NOW() + INTERVAL '24 hours' AS expires_at\n  FROM eligible_reservation\n),\nstored_token AS (\n  INSERT INTO action_tokens (\n    token_hash,\n    assignment_id,\n    trip_id,\n    driver_id,\n    action,\n    expires_at\n  )\n  SELECT\n    encode(digest(token, 'sha256'), 'hex'),\n    assignment_id,\n    trip_id,\n    driver_id,\n    'PERFUNDIM',\n    expires_at\n  FROM generated_token\n  RETURNING token_hash\n)\nSELECT\n  COUNT(*)::integer AS tokens_created,\n  MAX(g.token) AS finish_token,\n  MAX(g.expires_at) AS expires_at\nFROM generated_token g\nJOIN stored_token s\n  ON s.token_hash =\n     encode(digest(g.token, 'sha256'), 'hex');",
        "options": {
          "queryReplacement": "={{ [\n  $('Rezervo përpunimin e fillimit').first().json.operation.operation_key,\n  $execution.id\n] }}"
        }
      },
