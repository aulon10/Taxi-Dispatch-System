    {
      "parameters": {
        "jsCode": "const tokens = $('Krijo tokenin e përfundimit').first().json;\nconst driverRecord = $input.first().json;\nconst driver = driverRecord.fields ?? driverRecord;\n\nconst tripRecord = $('Lexo udhëtimin për fillim').first().json;\nconst trip = tripRecord.fields ?? tripRecord;\n\nif (\n  tokens.tokens_created !== 1 ||\n  typeof tokens.finish_token !== 'string' ||\n  !/^[a-f0-9]{64}$/.test(tokens.finish_token)\n) {\n  throw new Error('Tokeni i përfundimit nuk u krijua.');\n}\n\nfunction required(value, label) {\n  const text = String(value ?? '').trim();\n  if (!text) {\n    throw new Error(`Mungon: ${label}`);\n  }\n  return text;\n}\n\nconst to = required(driver.Email, 'email-i i shoferit');\nconst name = required(driver['Emri i plotë'], 'emri i shoferit');\nconst pickup = required(trip['Lokacioni i marrjes'], 'nisja');\nconst destination = required(trip.Destinacioni, 'destinacioni');\n\nconst finishUrl =\n  'https://aulon10.app.n8n.cloud/webhook-test/taxi-trip-finish-confirm'\n  + '?token=' + tokens.finish_token;\n\nreturn [{\n  json: {\n    to,\n    subject: 'Konfirmimi i përfundimit të udhëtimit',\n    message: [\n      `Përshëndetje ${name},`,\n      '',\n      'Fillimi i udhëtimit u regjistrua.',\n      `Nisja: ${pickup}`,\n      `Destinacioni: ${destination}`,\n      '',\n      'Kur ta përfundosh udhëtimin, hape këtë link dhe zgjidh PO:',\n      finishUrl,\n      '',\n      'Nëse ende je në udhëtim, zgjidh JO.'\n    ].join('\\n')\n  },\n  pairedItem: { item: 0 }\n}];"
      },
