    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH matched_token AS (\n  SELECT\n    t.assignment_id,\n    t.trip_id,\n    t.driver_id,\n    t.action\n  FROM action_tokens t\n  JOIN driver_reservations r\n    ON r.assignment_id = t.assignment_id\n   AND r.trip_id = t.trip_id\n   AND r.driver_id = t.driver_id\n  WHERE t.token_hash = $1\n    AND t.action = 'FILLIM'\n    AND t.expires_at > NOW()\n    AND t.used_at IS NULL\n    AND EXISTS (\n      SELECT 1\n      FROM dispatch_operations o\n      WHERE o.operation_key = t.assignment_id || ':decision'\n        AND o.assignment_id = t.assignment_id\n        AND o.trip_id = t.trip_id\n        AND o.driver_id = t.driver_id\n        AND o.action = 'PRANO'\n        AND o.status = 'completed'\n    )\n)\nSELECT\n  EXISTS (\n    SELECT 1 FROM matched_token\n  ) AS valid_token,\n  (\n    SELECT row_to_json(t)\n    FROM matched_token t\n    LIMIT 1\n  ) AS token_data;",
        "options": {
          "queryReplacement": "={{ [ $('Kontrollo kërkesën e fillimit').first().json.tokenHash ] }}"
        }
      },
