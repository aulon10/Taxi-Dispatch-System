              "id": "02654b77-9bed-4afa-b395-ee0d6df6195e",
              "leftValue": "={{ (() => {\n  const tripRecord =\n    $('Lexo udhëtimin për fillim').first().json;\n  const trip = tripRecord.fields ?? tripRecord;\n  const driver = $json.fields ?? $json;\n  const token =\n    $('Verifiko tokenin e fillimit').first().json.token_data;\n\n  return tripRecord.id === token.trip_id\n    && $json.id === token.driver_id\n    && trip.Statusi === 'PRANUAR'\n    && Array.isArray(trip.Shoferi)\n    && trip.Shoferi.length === 1\n    && trip.Shoferi[0] === token.driver_id\n    && driver.Statusi === 'I ZËNË';\n})() }}",
