    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed_operation AS (\n  INSERT INTO dispatch_operations (\n    operation_key,\n    trip_id,\n    assignment_id,\n    driver_id,\n    action,\n    execution_id\n  )\n  SELECT\n    t.assignment_id || ':start',\n    t.trip_id,\n    t.assignment_id,\n    t.driver_id,\n    'FILLIM',\n    $2\n  FROM action_tokens t\n  JOIN driver_reservations r\n    ON r.assignment_id = t.assignment_id\n   AND r.trip_id = t.trip_id\n   AND r.driver_id = t.driver_id\n  WHERE t.token_hash = $1\n    AND t.action = 'FILLIM'\n    AND t.expires_at > NOW()\n    AND t.used_at IS NULL\n    AND EXISTS (\n      SELECT 1\n      FROM dispatch_operations accepted\n      WHERE accepted.operation_key =\n            t.assignment_id || ':decision'\n        AND accepted.trip_id = t.trip_id\n        AND accepted.assignment_id = t.assignment_id\n        AND accepted.driver_id = t.driver_id\n        AND accepted.action = 'PRANO'\n        AND accepted.status = 'completed'\n    )\n  ON CONFLICT DO NOTHING\n  RETURNING *\n)\nSELECT\n  EXISTS (\n    SELECT 1 FROM claimed_operation\n  ) AS claimed,\n  (\n    SELECT row_to_json(o)\n    FROM claimed_operation o\n  ) AS operation;",
        "options": {
          "queryReplacement": "={{ [\n  $('Kontrollo kërkesën e fillimit').first().json.tokenHash,\n  $execution.id\n] }}"
        }
      },
