    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH finished_operation AS (\n  UPDATE dispatch_operations o\n  SET\n    status = 'completed',\n    completed_at = NOW()\n  WHERE o.operation_key = $1\n    AND o.execution_id = $2\n    AND o.action = 'FILLIM'\n    AND o.status = 'processing'\n    AND EXISTS (\n      SELECT 1\n      FROM driver_reservations r\n      WHERE r.assignment_id = o.assignment_id\n        AND r.trip_id = o.trip_id\n        AND r.driver_id = o.driver_id\n    )\n  RETURNING\n    o.assignment_id,\n    o.trip_id,\n    o.driver_id\n),\ninvalidated_tokens AS (\n  UPDATE action_tokens t\n  SET used_at = NOW()\n  FROM finished_operation o\n  WHERE t.assignment_id = o.assignment_id\n    AND t.trip_id = o.trip_id\n    AND t.driver_id = o.driver_id\n    AND t.action = 'FILLIM'\n    AND t.used_at IS NULL\n  RETURNING t.token_hash\n)\nSELECT\n  (\n    SELECT COUNT(*)::integer\n    FROM finished_operation\n  ) AS completed_count,\n  (\n    SELECT COUNT(*)::integer\n    FROM invalidated_tokens\n  ) AS invalidated_tokens_count;",
        "options": {
          "queryReplacement": "={{ [\n  $('Rezervo përpunimin e fillimit').first().json.operation.operation_key,\n  $execution.id\n] }}"
        }
      },
