    {
      "parameters": {
        "jsCode": "const request =\n  $('Kontrollo kërkesën e verifikimit').first().json;\n\nconst records = $input.all()\n  .map(item => item.json)\n  .filter(record =>\n    typeof record.id === 'string' &&\n    record.id.startsWith('rec')\n  );\n\nconst record = records.length === 1 ? records[0] : null;\nconst fields = record ? (record.fields ?? record) : {};\n\nconst savedEmail = String(fields.Email ?? '')\n  .trim()\n  .toLowerCase();\n\nconst status = String(fields.Statusi ?? '')\n  .trim()\n  .toUpperCase();\n\nconst clientAllowed =\n  request.role !== 'CLIENT' ||\n  ['AKTIV', 'GUEST'].includes(status);\n\nconst canSendCode =\n  record !== null &&\n  savedEmail === request.email &&\n  clientAllowed;\n\nreturn [{\n  json: {\n    role: request.role,\n    email: request.email,\n    matchesFound: records.length,\n    canSendCode,\n    actorId: canSendCode ? record.id : null\n  }\n}];"
      },
