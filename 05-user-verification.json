        "query": "CREATE OR REPLACE FUNCTION public.taxi_verify_auth_code(\n  p_challenge_id UUID,\n  p_code TEXT\n)\nRETURNS JSONB\nLANGUAGE plpgsql\nSET search_path = public, pg_temp\nAS $$\nDECLARE\n  v_challenge public.taxi_auth_challenges%ROWTYPE;\n  v_now TIMESTAMPTZ;\n  v_matches BOOLEAN;\n  v_attempts INTEGER;\n  v_token TEXT;\n  v_expires TIMESTAMPTZ;\nBEGIN\n  IF p_challenge_id IS NULL\n     OR p_code IS NULL\n     OR p_code !~ '^[0-9]{6}$' THEN\n    RETURN jsonb_build_object(\n      'ok', false,\n      'code', 'INVALID_REQUEST',\n      'message', 'Shkruaj kodin gjashtëshifror.'\n    );\n  END IF;\n\n  SELECT c.*\n  INTO v_challenge\n  FROM public.taxi_auth_challenges c\n  WHERE c.challenge_id = p_challenge_id\n  FOR UPDATE;\n\n  IF NOT FOUND THEN\n    RETURN jsonb_build_object(\n      'ok', false,\n      'code', 'CODE_UNAVAILABLE',\n      'message', 'Kodi nuk është i vlefshëm. Kërko kod të ri.'\n    );\n  END IF;\n\n  v_now := clock_timestamp();\n\n  IF v_challenge.consumed_at IS NOT NULL\n     OR v_challenge.expires_at <= v_now\n     OR v_challenge.delivery_status <> 'sent' THEN\n    RETURN jsonb_build_object(\n      'ok', false,\n      'code', 'CODE_UNAVAILABLE',\n      'message', 'Kodi ka skaduar ose nuk është më i vlefshëm. Kërko kod të ri.'\n    );\n  END IF;\n\n  IF v_challenge.attempts >= 5 THEN\n    RETURN jsonb_build_object(\n      'ok', false,\n      'code', 'ATTEMPTS_EXCEEDED',\n      'message', 'Ke arritur kufirin e tentimeve. Kërko kod të ri.'\n    );\n  END IF;\n\n  v_matches :=\n    crypt(p_code, v_challenge.code_hash)\n    = v_challenge.code_hash;\n\n  v_now := clock_timestamp();\n\n  IF v_challenge.expires_at <= v_now THEN\n    RETURN jsonb_build_object(\n      'ok', false,\n      'code', 'CODE_UNAVAILABLE',\n      'message', 'Kodi ka skaduar. Kërko kod të ri.'\n    );\n  END IF;\n\n  IF v_matches IS NOT TRUE THEN\n    UPDATE public.taxi_auth_challenges c\n    SET attempts = c.attempts + 1\n    WHERE c.challenge_id = p_challenge_id\n    RETURNING c.attempts INTO v_attempts;\n\n    RETURN jsonb_build_object(\n      'ok', false,\n      'code', CASE\n        WHEN v_attempts >= 5 THEN 'ATTEMPTS_EXCEEDED'\n        ELSE 'INVALID_CODE'\n      END,\n      'attemptsRemaining', 5 - v_attempts,\n      'message', CASE\n        WHEN v_attempts >= 5\n          THEN 'Ke arritur kufirin e tentimeve. Kërko kod të ri.'\n        ELSE 'Kodi nuk është i saktë. Kontrolloje dhe provo përsëri.'\n      END\n    );\n  END IF;\n\n  v_token := encode(gen_random_bytes(32), 'hex');\n  v_expires := v_now + INTERVAL '4 hours';\n\n  UPDATE public.taxi_auth_challenges c\n  SET consumed_at = v_now\n  WHERE c.challenge_id = p_challenge_id;\n\n  INSERT INTO public.taxi_auth_sessions (\n    token_hash,\n    challenge_id,\n    actor_id,\n    role,\n    email,\n    created_at,\n    expires_at\n  )\n  VALUES (\n    encode(digest(v_token, 'sha256'), 'hex'),\n    v_challenge.challenge_id,\n    v_challenge.actor_id,\n    v_challenge.role,\n    v_challenge.email,\n    v_now,\n    v_expires\n  );\n\n  RETURN jsonb_build_object(\n    'ok', true,\n    'code', 'VERIFIED',\n    'role', v_challenge.role,\n    'sessionToken', v_token,\n    'expiresAt', v_expires,\n    'message', 'Hyrja u konfirmua.'\n  );\nEND;\n$$;\n\nSELECT to_regprocedure(\n  'public.taxi_verify_auth_code(uuid,text)'\n) IS NOT NULL AS verification_function_ready;",
        "options": {}
      },
