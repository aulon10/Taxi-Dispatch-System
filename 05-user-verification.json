        "jsCode": "const body = $json.body ?? {};\n\nconst role = typeof body.role === 'string'\n  ? body.role.trim().toUpperCase()\n  : '';\n\nconst email = typeof body.email === 'string'\n  ? body.email.trim().toLowerCase()\n  : '';\n\nconst validRole = ['CLIENT', 'DRIVER'].includes(role);\n\nconst validEmail =\n  email.length <= 254 &&\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nreturn {\n  json: {\n    role,\n    email,\n    validRequest: validRole && validEmail\n  }\n};"
      },
