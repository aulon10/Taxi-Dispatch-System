    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst isPost =\n  $('Merr konfirmimin e fillimit').isExecuted;\n\nconst token = isPost\n  ? $json.body?.token\n  : $json.query?.token;\n\nconst validTokenFormat =\n  typeof token === 'string' &&\n  /^[a-f0-9]{64}$/.test(token);\n\nconst decision = isPost\n  ? $json.body?.decision\n  : null;\n\nconst validDecision =\n  !isPost || ['PO', 'JO'].includes(decision);\n\nreturn {\n  json: {\n    isPost,\n    validRequest: validTokenFormat && validDecision,\n    decision: validDecision ? decision : null,\n    token: validTokenFormat ? token : null,\n    tokenHash: validTokenFormat\n      ? crypto.createHash('sha256').update(token).digest('hex')\n      : null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
