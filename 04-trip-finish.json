    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH owned_operation AS (\n  SELECT o.*\n  FROM dispatch_operations o\n  WHERE o.operation_key = $1\n    AND o.execution_id = $2\n    AND o.action = 'PERFUNDIM'\n    AND o.status = 'processing'\n  FOR UPDATE\n),\nreleased_reservation AS (\n  DELETE FROM driver_reservations r\n  USING owned_operation o\n  WHERE r.assignment_id = o.assignment_id\n    AND r.trip_id = o.trip_id\n    AND r.driver_id = o.driver_id\n  RETURNING\n    r.assignment_id,\n    r.trip_id,\n    r.driver_id\n),\nfinished_operation AS (\n  UPDATE dispatch_operations o\n  SET\n    status = 'completed',\n    completed_at = NOW()\n  FROM released_reservation r\n  WHERE o.operation_key = $1\n    AND o.execution_id = $2\n    AND o.action = 'PERFUNDIM'\n    AND o.status = 'processing'\n    AND o.assignment_id = r.assignment_id\n    AND o.trip_id = r.trip_id\n    AND o.driver_id = r.driver_id\n  RETURNING\n    o.assignment_id,\n    o.trip_id,\n    o.driver_id\n),\ninvalidated_tokens AS (\n  UPDATE action_tokens t\n  SET used_at = NOW()\n  FROM finished_operation o\n  WHERE t.assignment_id = o.assignment_id\n    AND t.trip_id = o.trip_id\n    AND t.driver_id = o.driver_id\n    AND t.used_at IS NULL\n  RETURNING t.token_hash\n)\nSELECT\n  (\n    SELECT COUNT(*)::integer\n    FROM finished_operation\n  ) AS completed_count,\n  (\n    SELECT COUNT(*)::integer\n    FROM released_reservation\n  ) AS released_count,\n  (\n    SELECT COUNT(*)::integer\n    FROM invalidated_tokens\n  ) AS invalidated_tokens_count;",
        "options": {
          "queryReplacement": "={{ [\n  $('Rezervo përpunimin e fillimit').first().json.operation.operation_key,\n  $execution.id\n] }}"
        }
      },
