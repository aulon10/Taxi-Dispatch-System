    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH token_checks AS (\n  SELECT\n    t.assignment_id,\n    t.trip_id,\n    t.driver_id,\n    t.action,\n    t.used_at IS NULL AS unused,\n    t.expires_at > NOW() AS not_expired,\n\n    EXISTS (\n      SELECT 1\n      FROM public.driver_reservations r\n      WHERE r.assignment_id = t.assignment_id\n        AND r.trip_id = t.trip_id\n        AND r.driver_id = t.driver_id\n    ) AS reservation_matches,\n\n    EXISTS (\n      SELECT 1\n      FROM public.dispatch_operations o\n      WHERE o.operation_key = t.assignment_id || ':start'\n        AND o.assignment_id = t.assignment_id\n        AND o.trip_id = t.trip_id\n        AND o.driver_id = t.driver_id\n        AND o.action = 'FILLIM'\n        AND o.status = 'completed'\n    ) AS start_completed\n\n  FROM public.action_tokens t\n  WHERE t.token_hash = $1\n),\nvalid AS (\n  SELECT assignment_id, trip_id, driver_id, action\n  FROM token_checks\n  WHERE action = 'PERFUNDIM'\n    AND unused\n    AND not_expired\n    AND reservation_matches\n    AND start_completed\n)\nSELECT\n  $1::text AS received_hash,\n  EXISTS (\n    SELECT 1 FROM token_checks\n  ) AS token_found,\n  (\n    SELECT row_to_json(c) FROM token_checks c\n  ) AS checks,\n  EXISTS (\n    SELECT 1 FROM valid\n  ) AS valid_token,\n  (\n    SELECT row_to_json(v) FROM valid v\n  ) AS token_data;",
        "options": {
          "queryReplacement": "={{ [\n  $('Kontrollo kërkesën e fillimit').first().json.tokenHash\n] }}"
        }
      },
